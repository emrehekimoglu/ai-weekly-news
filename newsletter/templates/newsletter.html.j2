{#- "Haftalık Dergi" tasarımı: e-posta istemcileri için tablo düzeni ve satır içi stiller.
    <style> sadece mobil ve karanlık mod içindir; desteklemeyen istemciler satır içi stillerle açık temayı gösterir. -#}
{% set sans = "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" %}
{% set serif = "Georgia, 'Times New Roman', serif" %}
{% set lead = digest.entries[0] %}
{#- Habere 👍/👎: sadece abonelere giden e-postada (feedback_url verildiğinde) çıkar, arşivde çıkmaz. -#}
{% macro story_votes(story) %}{% if feedback_url %}&nbsp; <a href="{{ feedback_url(story, 'up') }}" title="Faydalı" style="font-size: 15px; padding: 0 3px; text-decoration: none;">👍</a>&nbsp;<a href="{{ feedback_url(story, 'down') }}" title="Pek değil" style="font-size: 15px; padding: 0 3px; text-decoration: none;">👎</a>{% endif %}{% endmacro %}
<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>AI &amp; Teknoloji Radarı</title>
<style>
  body { margin: 0; padding: 0; -webkit-text-size-adjust: 100%; }
  a { text-decoration: none; }
  @media (max-width: 620px) {
    .w { width: 100% !important; }
    .px { padding-left: 20px !important; padding-right: 20px !important; }
    .headline { font-size: 30px !important; line-height: 36px !important; }
    .stack { display: block !important; width: 100% !important; }
  }
  @media (prefers-color-scheme: dark) {
    .outer { background: #0e1015 !important; }
    .paper { background: #171a21 !important; border-color: #262b35 !important; }
    .ink { color: #eceff5 !important; }
    .soft { color: #b6bdcb !important; }
    .faint { color: #8a93a6 !important; }
    .accent { color: #8fa6ff !important; }
    .num { color: #4a5366 !important; }
    .rule { border-color: #2a303b !important; }
    .rule-strong { border-color: #eceff5 !important; }
    .tldr { background: #1f2430 !important; }
    .mark { background: #5b4a12 !important; color: #ffe9a6 !important; }
    .btn { background: #8fa6ff !important; }
    .btn a { color: #0e1015 !important; }
  }
</style>
</head>
<body style="margin: 0; padding: 0; background-color: #eceff4;">
<div style="display: none; max-height: 0; overflow: hidden; mso-hide: all;">{{ digest.tldr[0] if digest.tldr else digest.intro }}</div>
<table role="presentation" class="outer" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#eceff4" style="background-color: #eceff4;">
<tr><td align="center" style="padding: 24px 0;">
<table role="presentation" class="w paper" width="620" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="width: 620px; max-width: 620px; background-color: #ffffff; border: 1px solid #dfe3ea;">

  <tr><td class="px" style="padding: 22px 40px 0 40px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
      <td class="ink" style="font: 700 12px/16px {{ sans }}; letter-spacing: 2px; color: #10141c;">AI &amp; TEKNOLOJİ RADARI</td>
      <td align="right" class="faint" style="font: 12px/16px {{ sans }}; color: #6b7385;">{{ digest.date }}</td>
    </tr></table>
    <div class="rule-strong" style="border-top: 3px solid #10141c; margin-top: 12px; font-size: 0; line-height: 0;">&nbsp;</div>
  </td></tr>

  <tr><td class="px ink headline" style="padding: 26px 40px 10px 40px; font: 700 38px/44px {{ serif }}; color: #10141c; letter-spacing: -0.5px;">{{ digest.headline or "Haftanın Özeti" }}</td></tr>
  <tr><td class="px soft" style="padding: 0 40px 24px 40px; font: italic 17px/27px {{ serif }}; color: #454d5c;">{{ digest.intro }}</td></tr>

  {% if digest.tldr %}
  <tr><td class="px" style="padding: 0 40px 26px 40px;">
    <table role="presentation" class="tldr" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f3f5f9" style="background-color: #f3f5f9; border-radius: 8px;"><tr><td style="padding: 18px 22px 16px 22px;">
      <span class="mark" style="font: 700 12px/16px {{ sans }}; letter-spacing: 1.5px; color: #10141c; background-color: #fde68a; padding: 3px 7px;">30 SANİYEDE BU HAFTA</span>
      {% for point in digest.tldr %}
      <div class="ink" style="font: 15px/23px {{ sans }}; color: #10141c; margin-top: 10px; padding-left: 18px; text-indent: -18px;">&rarr;&nbsp; {{ point }}</div>
      {% endfor %}
    </td></tr></table>
  </td></tr>
  {% endif %}

  <tr><td class="px" style="padding: 0 40px 26px 40px;">
    <div class="accent" style="font: 700 11px/14px {{ sans }}; letter-spacing: 1.5px; color: #2447d6; text-transform: uppercase;">Kapak Haberi · {{ lead.category }}</div>
    <div class="ink" style="font: 700 27px/33px {{ serif }}; color: #10141c; margin: 8px 0 10px 0;">{{ lead.title }}</div>
    <div class="soft" style="font: 16px/26px {{ sans }}; color: #343b48;">{{ lead.summary }}</div>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 18px 0 8px 0;"><tr>
      <td class="btn" bgcolor="#2447d6" style="background-color: #2447d6; border-radius: 6px;"><a href="{{ lead.item.link }}" style="display: inline-block; padding: 11px 20px; font: 700 14px {{ sans }}; color: #ffffff; text-decoration: none;">Haberin tamamı &rarr;</a></td>
    </tr></table>
    <div class="faint" style="font: 12px/18px {{ sans }}; color: #8a93a6;">{{ lead.item.source }} · {{ lead.item.date }}{{ story_votes(1) }}</div>
  </td></tr>

  {% if digest.stat %}
  <tr><td class="px" style="padding: 0 40px 26px 40px;">
    <table role="presentation" class="rule-strong" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top: 1px solid #10141c; border-bottom: 1px solid #10141c;"><tr>
      <td class="stack accent" width="42%" valign="middle" style="padding: 18px 12px 18px 0; font: 700 46px/52px {{ serif }}; color: #2447d6;">{{ digest.stat.value }}</td>
      <td class="stack soft" valign="middle" style="padding: 18px 0; font: 15px/23px {{ sans }}; color: #343b48;">
        <div class="ink" style="font: 700 11px/14px {{ sans }}; letter-spacing: 1.5px; color: #10141c; margin-bottom: 4px;">HAFTANIN RAKAMI</div>
        {{ digest.stat.label }}
      </td>
    </tr></table>
  </td></tr>
  {% endif %}

  {% if digest.entries | length > 1 %}
  <tr><td class="px ink" style="padding: 0 40px 4px 40px; font: 700 12px/16px {{ sans }}; letter-spacing: 2px; color: #10141c;">HAFTANIN GERİ KALANI</td></tr>
  {% for entry in digest.entries[1:] %}
  <tr><td class="px" style="padding: 0 40px;">
    <table role="presentation" class="rule" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top: 1px solid #e3e6ec;"><tr>
      <td class="num" width="52" valign="top" style="padding: 20px 0; font: 30px/30px {{ serif }}; color: #b7c0d2;">{{ "%02d" | format(loop.index + 1) }}</td>
      <td valign="top" style="padding: 20px 0 22px 0;">
        <div class="accent" style="font: 700 11px/14px {{ sans }}; letter-spacing: 1.5px; color: #2447d6; text-transform: uppercase;">{{ entry.category }}</div>
        <div class="ink" style="font: 700 19px/25px {{ serif }}; color: #10141c; margin: 6px 0;">{{ entry.title }}</div>
        <div class="soft" style="font: 15px/23px {{ sans }}; color: #454d5c;">{{ entry.summary }}</div>
        <div class="faint" style="font: 12px/18px {{ sans }}; color: #8a93a6; margin-top: 8px;"><a href="{{ entry.item.link }}" class="accent" style="font-weight: 700; color: #2447d6; text-decoration: none;">Devamı &rarr;</a>&nbsp; {{ entry.item.source }} · {{ entry.item.date }}{{ story_votes(loop.index + 1) }}</div>
      </td>
    </tr></table>
  </td></tr>
  {% endfor %}
  {% endif %}

  {% if feedback_url %}
  <tr><td class="px" style="padding: 8px 40px 22px 40px;">
    <table role="presentation" class="tldr" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f3f5f9" style="background-color: #f3f5f9; border-radius: 8px;"><tr>
      <td class="ink" style="padding: 16px 22px; font: 700 15px/22px {{ serif }}; color: #10141c;">Bu sayı nasıldı?</td>
      <td align="right" style="padding: 12px 22px 12px 0; white-space: nowrap;">
        <a href="{{ feedback_url(0, 'up') }}" class="accent" style="display: inline-block; padding: 7px 14px; border: 1px solid #2447d6; border-radius: 6px; font: 700 13px {{ sans }}; color: #2447d6; text-decoration: none;">👍 Beğendim</a>&nbsp;
        <a href="{{ feedback_url(0, 'down') }}" class="accent" style="display: inline-block; padding: 7px 14px; border: 1px solid #2447d6; border-radius: 6px; font: 700 13px {{ sans }}; color: #2447d6; text-decoration: none;">👎 Pek değil</a>
      </td>
    </tr></table>
    <div class="faint" style="font: 12px/18px {{ sans }}; color: #8a93a6; margin-top: 8px;">Haberlerin yanındaki 👍 👎 ile hangi konuların işinize yaradığını da söyleyebilirsiniz. Oylar isimsiz kaydedilir.</div>
  </td></tr>
  {% endif %}

  {% if signup_url %}
  <tr><td class="px" style="padding: 8px 40px 22px 40px;">
    <table role="presentation" class="tldr" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f3f5f9" style="background-color: #f3f5f9; border-radius: 8px;"><tr><td style="padding: 18px 22px;">
      <div class="ink" style="font: 700 17px/24px {{ serif }}; color: #10141c;">Bu sayıyı beğendiniz mi? Bir arkadaşınıza iletin.</div>
      <div class="soft" style="font: 14px/22px {{ sans }}; color: #454d5c; margin-top: 4px;">Bu e-posta size iletildiyse, yeni sayılar her pazartesi doğrudan size gelsin: <a href="{{ signup_url }}" class="accent" style="font-weight: 700; color: #2447d6; text-decoration: underline;">ücretsiz abone olun &rarr;</a></div>
    </td></tr></table>
  </td></tr>
  {% endif %}

  <tr><td class="px" style="padding: 0 40px 30px 40px;">
    <hr class="rule-strong" style="border: none; border-top: 3px solid #10141c; margin: 10px 0 18px 0;">
    <p class="faint" style="font: 12px/19px {{ sans }}; color: #8a93a6; margin: 0;">Bu bülteni AI &amp; Teknoloji Radarı'na abone olduğunuz için alıyorsunuz. Abonelikten ayrılmak isterseniz <a href="{{ unsubscribe_url or '#' }}" class="accent" style="color: #2447d6; text-decoration: underline;">buraya tıklayabilirsiniz</a>.{% if web_url %} Bu sayıyı <a href="{{ web_url }}" class="accent" style="color: #2447d6; text-decoration: underline;">web'de okuyabilir</a> ve bağlantısını paylaşabilirsiniz.{% endif %}</p>
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
